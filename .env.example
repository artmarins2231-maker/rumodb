# Copie este arquivo para ".env" (sem o ".example") e ajuste os valores.
# O server.js lê o .env automaticamente ao iniciar — não precisa reiniciar
# nada além do node server.js.

# Porta em que o servidor escuta.
PORT=3000

# "production" ativa o cabeçalho HSTS quando o site estiver atrás de HTTPS
# (direto ou via proxy reverso com x-forwarded-proto). Em dev local pode
# deixar "development".
NODE_ENV=production

# Domínio final do site, sem barra no final. Usado como referência interna;
# o que realmente importa pro Google é você editar robots.txt e sitemap.xml
# trocando __SITE_URL__ pelo mesmo valor.
SITE_URL=https://www.seudominio.com.br

# ---- AURORA com IA de verdade (opcional) ----
# Sem essas duas linhas, a AURORA continua funcionando normalmente no modo
# local (baseado em regras) — nada quebra. Preenchendo ANTHROPIC_API_KEY,
# ela passa a responder com um modelo de verdade da Anthropic, sempre
# baseada nos destinos/preços que o próprio site já calculou (não inventa
# preço nem hotel/companhia que não exista no site).
# Pegue sua chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo usado nas respostas da AURORA. Pode trocar por outro se preferir.
AI_MODEL=claude-sonnet-5